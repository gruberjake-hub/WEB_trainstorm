    {
      "id": "performance_over_time",
      "title": "How performance moves pay over time",
      "kind": "scene",
      "role": "topic",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "How performance moves pay over time",
            "kicker": "Pay for performance"
          },
          "meta": {
            "scene_id": "performance_over_time",
            "role": "topic"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Pay for Performance at Brunswick",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p",
            "composed_from": "atom_bw_framework_p4p",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Your base salary pays for the core expectations of your specific role.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p_base_role",
            "composed_from": "atom_bw_framework_p4p_base_role",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Annual incentives are the main way a year's accomplishments get rewarded: they measure performance against established business goals, and your individual performance links directly to your final payout.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p_annual_incentives",
            "composed_from": "atom_bw_framework_p4p_annual_incentives",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Salary and merit reviews keep us following market trends and aligned to pay for performance \u2014 and your performance in a given year, high or low, shapes your salary increase.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p_merit",
            "composed_from": "atom_bw_framework_p4p_merit",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Your incentive payout starts with the plan formula, then moves up or down with your individual performance \u2014 as measured through Achieve.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p_achieve",
            "composed_from": "atom_bw_framework_p4p_achieve",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "The Brunswick Performance Plan (BPP) is the key compensation tool behind our pay for performance culture \u2014 for the Company and for you. Most global salaried employees are eligible (the main exception: sales employees who earn commissions), and your bonus target is set by your salary grade.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_p4p_bpp",
            "composed_from": "atom_bw_framework_p4p_bpp",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_p4p",
              "depth": 1,
              "head": false
            }
          }
        }
      ]
    },
    {
      "id": "resources_and_eu",
      "title": "Where to learn more \u2014 and your EU rights",
      "kind": "scene",
      "role": "topic",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "Where to learn more \u2014 and your EU rights",
            "kicker": "Resources"
          },
          "meta": {
            "scene_id": "resources_and_eu",
            "role": "topic"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "How We Promote Pay Transparency. We're committed to pay transparency through our established practices and processes \u2014 and to enhancing those efforts, for fairness and clarity for you.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_transparency_practices",
            "composed_from": "atom_bw_framework_transparency_practices",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_transparency_practices",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Established practices, by pillar:",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_transparency_practices_practices",
            "composed_from": "atom_bw_framework_transparency_practices_practices",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_transparency_practices",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "StepList",
          "props": {
            "kicker": "",
            "title": "Established practices, by pillar:",
            "ordered": false,
            "items": [
              {
                "id": "ele_bw_framework_transparency_practices_practices_4",
                "composed_from": "atom_bw_framework_transparency_practices_practices_4",
                "text": "Employee Visibility: your compensation details in Workday; your Total Rewards Statement; merit and bonus letters with your annual performance review."
              }
            ]
          },
          "meta": {
            "element_ids": [
              "ele_bw_framework_transparency_practices_practices_4"
            ],
            "composed_from": [
              "atom_bw_framework_transparency_practices_practices_4"
            ],
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_transparency_practices",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Have questions about pay ranges in U.S. job postings? The Pay Transparency in U.S. job postings FAQ answers them \u2014 employee and manager questions alike \u2014 and includes a table of disclosure requirements, timing, and effective dates for each jurisdiction.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_faq_scope",
            "composed_from": "atom_bw_faq_scope",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_faq_scope",
              "depth": 0,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "The EU Pay Directive: pay transparency measures for workers and employers, aimed at reducing unexplained gender pay gaps. All 27 EU member countries must adopt regulations by June 2026.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_eoc_euptd",
            "composed_from": "atom_bw_eoc_euptd",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_eoc_euptd",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "You have the right to ask your employer about your own pay level \u2014 and about average pay levels, broken down by gender, for people doing the same work or work of equal value.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_eoc_euptd_right_to_info",
            "composed_from": "atom_bw_eoc_euptd_right_to_info",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_eoc_euptd",
              "depth": 1,
              "head": false
            }
          }
        }
      ]
    },
