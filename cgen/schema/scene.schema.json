{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene.schema.json",
  "title": "Trainstorm Scene Schema",
  "type": "object",
  "required": ["scene_id", "title", "elements"],
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^sce_[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(Head|SubHead|ContentHead|ListHead|List|Bullet|Statement|Paragraph|Impact|Quote|Callout)_[0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/sceneElement"
      }
    },
    "narration": {
      "type": "object"
    },
    "assets": {
      "type": "object"
    },
    "render": {
      "type": "object"
    }
  },
  "definitions": {
    "sceneElement": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Head",
            "SubHead",
            "ContentHead",
            "ListHead",
            "List",
            "Bullet",
            "Statement",
            "Paragraph",
            "Impact",
            "Quote",
            "Callout"
          ]
        },
        "intent": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "voice_text": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "text_primitive": {
          "type": "string"
        },
        "motion_primitive": {
          "type": "string"
        },
        "layout_primitive": {
          "type": "string"
        },
        "interaction_primitive": {
          "type": "string"
        },
        "style_ref": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}