            "sourceElementIds": [
              "s5_head_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "In practice, ALSAP is not something you recite. It is something that shapes how you think and respond during a conversation.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s5_u2",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s5_para_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Using ALSAP well means being intentional, not mechanical.",
            "emphasis": "medium",
            "role": "Statement"
          },
          "meta": {
            "renderUnitId": "s5_u3",
            "semanticRole": "Statement",
            "instructionalIntent": "assert",
            "treatment": "emphasized-assertion",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s5_statement_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "A superficial approach treats ALSAP as a checklist. A thoughtful approach uses it to guide judgment in real time, adjusting based on the situation and the person.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s5_u4",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s5_para_02"
            ]
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 3,
            "text": "The difference shows up in how the other person experiences the conversation."
          },
          "meta": {
            "renderUnitId": "s5_u5",
            "semanticRole": "Impact",
