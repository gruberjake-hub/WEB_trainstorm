  {
    "atom_id": "atom_bw_guide_philosophy_benchmarking_how",
    "content_hash": "sha256:c2fabeb9c41fa7488a5c5f0f86bbeebff1680fd122e6026d7f548c399195a70d",
    "meaning": {
      "source_locale": "en",
      "source_text": "Accurate job descriptions ensure proper role alignment in compensation surveys. Market data from trusted sources is used to assess job value and total rewards programs. We leverage a total rewards mindset to create a compelling package that attracts and retains top talent.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_philosophy",
        "order": 1
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_philosophy_equity",
    "content_hash": "sha256:6510637c7f3bca31f8547dde062ff8d61a92e32c095eac7a1a5416b99b60a922",
    "meaning": {
      "source_locale": "en",
      "source_text": "Balance External Competitiveness with Internal Equity.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_philosophy",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_philosophy_equity_how",
    "content_hash": "sha256:5f1c41e5b996185a87b614157279e1ca8d57f9d8620ada85f05310efa8e252be",
    "meaning": {
      "source_locale": "en",
      "source_text": "Market data is used as a guide, but internal equity is equally important when determining the right job grade. Jobs are assigned to the Brunswick grade structure based on both external market data and their internal value.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_philosophy",
        "order": 3
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_philosophy_p4p",
    "content_hash": "sha256:a9d258d6479bbba4bc47fe3061875088d476011356a201f26eb4986232a7c73d",
    "meaning": {
      "source_locale": "en",
      "source_text": "Link Pay to Individual, Team & Company Performance via Pay-for-Performance.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_philosophy",
        "order": 4
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_philosophy_p4p_how",
    "content_hash": "sha256:a28ee0f1020824918392cc69b5bb43ebf49284e73de3738766078c52ca8ec394",
    "meaning": {
      "source_locale": "en",
      "source_text": "Recognizing and rewarding exceptional performance through pay-for-performance strategies, such as annual merit increases and incentive plans, motivates employees and drives success. These rewards are based on individual contributions, as well as team and company performance.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_philosophy",
        "order": 5
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay",
    "content_hash": "sha256:7005aaff82439861b9111f8d1517f6b01819ae703be3982d19b6e09d1eb23180",
    "meaning": {
      "source_locale": "en",
      "source_text": "How Base Pay is Set.",
      "kind": "section"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_grades",
    "content_hash": "sha256:20831be783ef2536f96cbb6e526d110846d39e57ebf8352fe341aafc60f4d642",
    "meaning": {
      "source_locale": "en",
      "source_text": "Brunswick uses a traditional grade structure, with 24 pay ranges, that are closely tied to market rates based on our compensation surveys and benchmarking exercises.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay",
        "order": 0
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_zones",
    "content_hash": "sha256:8a253df5ece71f6c6f67ab607a16f31900d964499e3a05f4caccd35f1bf94d70",
    "meaning": {
      "source_locale": "en",
      "source_text": "The grade structure is divided into three geographic zones, each reflecting the cost of labor in different U.S. locations. This structure accounts for the varied pay rates across our widespread locations.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay",
        "order": 1
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_range",
    "content_hash": "sha256:c9a59c9774a9d5dfecabbc3044a56d2229bf8c975d96c82eb6176210d6529c7d",
    "meaning": {
      "source_locale": "en",
      "source_text": "In each grade there is a minimum, midpoint and maximum, as well as a market range for base salary. In addition, each grade has a target for incentive pay.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_range_positions",
    "content_hash": "sha256:21dccfaa50420a6d1e4189ab4974301e6c746e5af52a99ab1d6307c7c556f724",
    "meaning": {
      "source_locale": "en",
      "source_text": "The following illustrates where individuals would typically fall within the range in different scenarios.",
      "kind": "list"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay",
        "order": 3
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_range_positions_low",
    "content_hash": "sha256:03f7fc37d868cf4e4f07ec0d522a8f6e8bea7bbfcbe5ed6aa9c7a33d9e189c9d",
    "meaning": {
      "source_locale": "en",
      "source_text": "Lower in the range: new hires with minimal experience; recent promotions to much larger jobs; new to grade based on job evaluation; performance level is lower than expectations.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay_range_positions",
        "order": 0
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_range_positions_mid",
    "content_hash": "sha256:4e43401e2f1cb6ad899a734d6905469ad59bb40534b05cc5dc99a1cc6c66fd72",
    "meaning": {
      "source_locale": "en",
      "source_text": "Around the market median: successful performers who are “fully competent” in their role; experienced new hires.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay_range_positions",
        "order": 1
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_base_pay_range_positions_high",
    "content_hash": "sha256:4f3e3d95581ef5121566a3442021e47653932e74e90a9eeac7e8b0ef40336556",
    "meaning": {
      "source_locale": "en",
      "source_text": "Higher in the range: long-term employees who have remained in role; highly skilled/high demand positions; highest sustained performers.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_base_pay_range_positions",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship",
    "content_hash": "sha256:ea6a107f872cd0922bc5604c23e6a627bdbfb98a08a666b8c0aa510c5477c039",
    "meaning": {
      "source_locale": "en",
      "source_text": "Shaping Pay Programs and Practices as Part of Enterprise HR: the Compensation and Benefits team within Enterprise HR, in strong partnership with the division HR teams, conducts regular reviews of compensation data, benchmarking against market trends, and assesses internal pay levels to ensure fair and competitive pay for all employees.",
      "kind": "section"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide",
        "order": 3
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities",
    "content_hash": "sha256:4f789e5b9c154844dab16722b0991c59b5ae7412f1c98db3394593e38098151f",
    "meaning": {
      "source_locale": "en",
      "source_text": "Key activities that are completed at the enterprise level:",
      "kind": "list"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship",
        "order": 0
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities_1",
    "content_hash": "sha256:29a45ed0deab67b3b7de812dd6c097218095cd22e11763216aa37f9cedbb339a",
    "meaning": {
      "source_locale": "en",
      "source_text": "Conduct annual calibration during rewards planning to ensure consistent and equitable pay decisions across teams.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship_activities",
        "order": 0
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities_2",
    "content_hash": "sha256:bb9fbce60ec90d3a2f36e946c3a8c0cf8851a0da960a013207167a7471cbe391",
    "meaning": {
      "source_locale": "en",
      "source_text": "Participate in market surveys to benchmark compensation against industry standards and ensure competitiveness.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship_activities",
        "order": 1
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities_3",
    "content_hash": "sha256:4ede758ac4b3de8126d471d5e5df568c46743702ddd4fe59f5ed6430e5985335",
    "meaning": {
      "source_locale": "en",
      "source_text": "Perform on-demand and planned role analyses to assess job responsibilities, market value, and internal equity.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship_activities",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities_4",
    "content_hash": "sha256:287d84ec8b44f2eeaa2db6c87d3e2e2d64fe0259369f87e605c2b69484c8c8ed",
    "meaning": {
      "source_locale": "en",
      "source_text": "Regularly review and adjust compensation structures to maintain fairness and alignment with organizational goals.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship_activities",
        "order": 3
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_stewardship_activities_5",
    "content_hash": "sha256:0ce65790a57eddfe20c53add6373bf1655a445fa47bcf87df908fc881c7cafb9",
    "meaning": {
      "source_locale": "en",
      "source_text": "Work closely with local HR to ensure fair and consistent application of pay practices across the organization.",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide_stewardship_activities",
        "order": 4
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "none",
      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_guide_calendar",
    "content_hash": "sha256:d580e51aefe1bd29047a545b5d8e2fbee7ad43db45d82bdbd1a213cfdb35a577",
    "meaning": {
      "source_locale": "en",
      "source_text": "Salary decisions are part of a broader set of activities that leaders consider including individual and company performance, salary budgets and market data. Managers should consider salary increases and planning as part of the annual compensation planning process.",
      "kind": "statement"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_guide",
        "order": 4
      }
    },
    "governance": {
      "version": 1,
