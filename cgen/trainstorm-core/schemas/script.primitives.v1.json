{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainstorm.ai/schemas/script.primitives.v1.json",
  "title": "Trainstorm Script Primitives (Generation IR)",
  "description": "The SEMANTIC generation layer: an ordered array of didactic moves emitted from source material, BEFORE presentation. Each primitive is a typed knowledge structure (a definition has term+meaning; a process_flow has steps). Primitives are realized DOWNSTREAM into presentation elements (see the placement doc's realization table). This is a governed, closed vocabulary — a new primitive type requires a version bump. Completed from v1 (which defined only orientation/context_frame/definition).",
  "type": "array",
  "items": { "$ref": "#/$defs/primitive" },
  "$defs": {
    "primitive": {
      "oneOf": [
        { "$ref": "#/$defs/orientation" },
        { "$ref": "#/$defs/context_frame" },
        { "$ref": "#/$defs/definition" },
        { "$ref": "#/$defs/decomposition" },
        { "$ref": "#/$defs/distinction" },
        { "$ref": "#/$defs/process_flow" },
        { "$ref": "#/$defs/role_relevance" },
        { "$ref": "#/$defs/knowledge_check" },
        { "$ref": "#/$defs/boundary_statement" },
        { "$ref": "#/$defs/resource_pointer" },
        { "$ref": "#/$defs/closure" }
      ]
    },

    "labeledPart": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" }
      }
    },

    "orientation": {
      "type": "object",
      "description": "Situates the learner: what this is / what's ahead.",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "orientation" },
        "text": { "type": "string" },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Value from intent.enum.json (pedagogical). Default: objective. Enforced by the linter." },
        "notes": { "type": "string" }
      }
    },

    "context_frame": {
      "type": "object",
      "description": "Establishes the problem/stakes that motivate the content.",
      "required": ["type", "problem"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "context_frame" },
        "problem": { "type": "string" },
        "risk": { "type": "string", "description": "What's at stake if unaddressed." },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: hook (or activate)." },
        "notes": { "type": "string" }
      }
    },

    "definition": {
      "type": "object",
      "description": "Names and explains a term.",
      "required": ["type", "term", "meaning"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "definition" },
        "term": { "type": "string" },
        "meaning": { "type": "string" },
        "example": { "type": "string" },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: present." },
        "notes": { "type": "string" }
      }
    },

    "decomposition": {
      "type": "object",
      "description": "Breaks a whole into its constituent parts.",
      "required": ["type", "whole", "parts"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "decomposition" },
        "whole": { "type": "string", "description": "The thing being broken down." },
        "parts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/labeledPart" } },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: present (or exemplify)." },
        "notes": { "type": "string" }
      }
    },

    "distinction": {
      "type": "object",
      "description": "Contrasts two or more things; often corrects a common confusion.",
      "required": ["type", "distinguishes"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "distinction" },
        "distinguishes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/labeledPart" } },
        "basis": { "type": "string", "description": "The dimension along which they differ." },
        "common_confusion": { "type": "string", "description": "The misconception this corrects." },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: exemplify." },
        "notes": { "type": "string" }
      }
    },

    "process_flow": {
      "type": "object",
      "description": "An ordered sequence of steps or stages.",
      "required": ["type", "steps"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "process_flow" },
        "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/labeledPart" } },
        "cyclical": { "type": "boolean", "default": false },
        "trigger": { "type": "string", "description": "What starts the process." },
        "outcome": { "type": "string", "description": "What the process produces." },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: exemplify." },
        "notes": { "type": "string" }
      }
    },

    "role_relevance": {
      "type": "object",
      "description": "Why this matters to the learner's specific role or situation.",
      "required": ["type", "relevance"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "role_relevance" },
        "relevance": { "type": "string", "description": "Why it matters to the learner." },
        "role": { "type": "string", "description": "Optional target role/segment (may map to audience.segment_scope)." },
        "example": { "type": "string", "description": "A concrete 'for you, this means…' instance." },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: activate (or transfer)." },
        "notes": { "type": "string" }
      }
    },

    "knowledge_check": {
      "type": "object",
      "description": "A check for understanding.",
      "required": ["type", "prompt", "options"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "knowledge_check" },
        "prompt": { "type": "string" },
        "check_type": { "type": "string", "enum": ["recall", "application", "scenario"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["label", "correct"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "correct": { "type": "boolean" },
              "feedback": { "type": "string" }
            }
          }
        },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: practice (or assess)." },
        "notes": { "type": "string" }
      }
    },

    "boundary_statement": {
      "type": "object",
      "description": "Scope, limits, caveats, or edge cases — what this does or does NOT cover.",
      "required": ["type", "boundary"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "boundary_statement" },
        "boundary": { "type": "string", "description": "The limit or caveat." },
        "applies_when": { "type": "string" },
        "excludes": { "type": "string" },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: present." },
        "notes": { "type": "string" }
      }
    },

    "resource_pointer": {
      "type": "object",
      "description": "Points to an external resource, system, or job aid.",
      "required": ["type", "resource"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "resource_pointer" },
        "resource": { "type": "string", "description": "The resource / system name." },
        "location": { "type": "string", "description": "Where to find it (portal, URL, system path)." },
        "purpose": { "type": "string", "description": "What to use it for." },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: transfer." },
        "notes": { "type": "string" }
      }
    },

    "closure": {
      "type": "object",
      "description": "Wraps up: recap, key takeaway, and/or call to action.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "closure" },
        "takeaway": { "type": "string", "description": "The one thing to remember." },
        "recap": { "type": "array", "items": { "type": "string" } },
        "call_to_action": { "type": "string" },
        "id": { "type": "string" },
        "pedagogical_intent": { "type": "string", "description": "Default: reinforce." },
        "notes": { "type": "string" }
      }
    }
  }
}
