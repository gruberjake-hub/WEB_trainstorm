    {
      "id": "resources_and_eu",
      "title": "Where to learn more \u2014 and your EU rights",
      "kind": "scene",
      "role": "topic",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "Where to learn more \u2014 and your EU rights",
            "kicker": "Resources"
          },
          "meta": {
            "scene_id": "resources_and_eu",
            "role": "topic"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "How does Brunswick promote pay transparency? We are committed to promoting pay transparency through our established practices and processes and are dedicated to further enhance pay transparency efforts to ensure fairness and clarity for employees.",
            "kicker": "Present"
          },
          "meta": {
            "element_id": "ele_bw_framework_transparency_practices",
            "composed_from": "atom_bw_framework_transparency_practices",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Established practices, by pillar:",
            "kicker": "Present"
          },
          "meta": {
            "element_id": "ele_bw_framework_transparency_practices_practices",
            "composed_from": "atom_bw_framework_transparency_practices_practices",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        },
        {
          "type": "StepList",
          "props": {
            "kicker": "Scope list",
            "title": "Established practices, by pillar:",
            "ordered": false,
            "items": [
              {
                "id": "ele_bw_framework_transparency_practices_practices_4",
                "composed_from": "atom_bw_framework_transparency_practices_practices_4",
                "text": "Employee Visibility: Workday access to personal compensation details; Total Rewards Statement; merit/bonus letters communicated with annual performance reviews."
              }
            ]
          },
          "meta": {
            "element_ids": [
              "ele_bw_framework_transparency_practices_practices_4"
            ],
            "composed_from": [
              "atom_bw_framework_transparency_practices_practices_4"
            ],
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "The FAQ answers employee and manager questions about pay ranges in U.S. job postings and includes a per-jurisdiction table of disclosure requirements, timing, and effective dates. For more information, review the Pay Transparency in U.S. job postings FAQ.",
            "kicker": "Present"
          },
          "meta": {
            "element_id": "ele_bw_faq_scope",
            "composed_from": "atom_bw_faq_scope",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "EU Pay Directive Overview: measures to ensure pay transparency for workers and employers, and reducing unexplained gender pay gaps. Each of the 27 EU member countries must adopt regulations by June 2026.",
            "kicker": "Present"
          },
          "meta": {
            "element_id": "ele_bw_eoc_euptd",
            "composed_from": "atom_bw_eoc_euptd",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Right to information for employees: employees have the right to request information from their employer on their individual pay level, and on average pay levels, broken down by gender, for categories of workers doing the same work or work of equal value.",
            "kicker": "Present"
          },
          "meta": {
            "element_id": "ele_bw_eoc_euptd_right_to_info",
            "composed_from": "atom_bw_eoc_euptd_right_to_info",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional"
          }
        }
      ]
    },
