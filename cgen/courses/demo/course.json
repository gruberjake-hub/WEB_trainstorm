            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "ALSAP is most useful when you understand what each part is helping you do in the moment, not just what each letter stands for.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s4_u2",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
