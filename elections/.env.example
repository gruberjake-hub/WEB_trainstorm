# ---------------------------------------------------------------------------
# Copy this file to a new file named ".env" and fill in your real values.
# The .env file is git-ignored, so your secret key never gets committed.
# On a host like Render, you set these same names in the dashboard instead of
# using a file.
# ---------------------------------------------------------------------------

# REQUIRED: your Anthropic API key (starts with "sk-ant-").
# Get one at https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# OPTIONAL: which model does the drafting. Default is claude-sonnet-5.
# Cheapest: claude-haiku-4-5-20251001   Highest quality: claude-opus-5
MODEL=claude-sonnet-5

# OPTIONAL but recommended for a public URL: a shared password your fellows
# must type before they can generate a draft. This protects your API key from
# strangers running up a bill. Leave blank to disable the gate.
ACCESS_CODE=

# OPTIONAL: the port the server listens on locally. Hosts set this for you.
PORT=3000
