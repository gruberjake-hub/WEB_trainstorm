    {
      "id": "s3",
      "title": "The ALSAP Framework",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "The ALSAP Framework"
          },
          "meta": {
            "renderUnitId": "s3_u1",
            "semanticRole": "Head",
            "instructionalIntent": "orient",
            "treatment": "summary-highlight",
            "primitive": "StaticHead",
            "styleRef": "head-primary",
            "sourceElementIds": [
              "s3_head_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "ALSAP is easier to use when you see it as a sequence of moves rather than as a list of abstract terms. Each part plays a different role in helping a conversation move forward productively.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s3_u2",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s3_para_01"
            ]
          }
        },
        {
          "type": "RevealCards",
          "props": {
            "id": "s3_list_01",
            "items": [
              {
                "id": "s3_item_01",
                "title": "A — Assess",
                "body": "Take stock of the situation before reacting. What is happening, what is at stake, and what context matters?"
              },
              {
                "id": "s3_item_02",
                "title": "L — Listen",
                "body": "Make space to understand the other person's perspective rather than rushing to your own conclusion."
              },
              {
                "id": "s3_item_03",
                "title": "S — Specify",
                "body": "Clarify the issue, expectation, or concern in concrete terms so the conversation stays grounded."
              },
              {
                "id": "s3_item_04",
                "title": "A — Align",
                "body": "Create shared understanding around what matters, what good looks like, and what both parties are working toward."
              },
              {
                "id": "s3_item_05",
                "title": "P — Proceed",
                "body": "Move toward the next right action so the conversation leads somewhere useful rather than ending as vague discussion."
              }
            ],
            "requireAllRevealedToComplete": true
          },
          "meta": {
            "renderUnitId": "s3_u3",
            "semanticRole": "List",
            "instructionalIntent": "structure",
            "treatment": "progressive-reveal",
            "primitive": "CardReveal",
            "styleRef": "list-body",
            "sourceElementIds": [
              "s3_list_01"
            ]
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 3,
            "text": "The value of ALSAP is not in memorizing the letters. It is in using the sequence to think and act with greater intention."
          },
          "meta": {
            "renderUnitId": "s3_u4",
            "semanticRole": "Impact",
            "instructionalIntent": "persuade",
            "treatment": "emphasized-assertion",
            "primitive": "FocusReveal",
            "styleRef": "impact-emphasis",
            "sourceElementIds": [
              "s3_impact_01"
            ]
          }
        }
      ],
