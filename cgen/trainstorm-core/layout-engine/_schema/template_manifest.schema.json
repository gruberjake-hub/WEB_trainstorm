{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgen.local/schema/template_manifest.schema.json",
  "title": "Template Manifest",
  "description": "Machine-extracted description of a .potx brand shell: theme tokens + per-layout slot geometry + Storyline binding metadata. GENERATED by the extractor from a .potx, not hand-authored. This is the artifact your 'tune in PowerPoint, generate JSON' step produces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_ref", "theme", "canvas", "layouts"],
  "properties": {
    "template_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "description": "Identity of the source .potx. The sha256 is what a sidecar pins to, so policy and shell can't silently drift.",
      "properties": {
        "file": { "type": "string", "description": "Path/URI to the .potx (git-LFS or artifact store)." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "version": { "type": "string" },
        "extracted_utc": { "type": "string", "description": "ISO-8601; stamped by the extractor." }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "fonts"],
      "description": "Pulled straight from the .potx theme1.xml. This is the brand skin, extracted — no hand-transcription.",
      "properties": {
        "colors": {
          "type": "object",
          "description": "OOXML theme color slots. accent1..6 are your categorical/brand hues.",
          "additionalProperties": false,
          "properties": {
            "dk1": { "$ref": "#/$defs/hex" }, "lt1": { "$ref": "#/$defs/hex" },
            "dk2": { "$ref": "#/$defs/hex" }, "lt2": { "$ref": "#/$defs/hex" },
            "accent1": { "$ref": "#/$defs/hex" }, "accent2": { "$ref": "#/$defs/hex" },
            "accent3": { "$ref": "#/$defs/hex" }, "accent4": { "$ref": "#/$defs/hex" },
            "accent5": { "$ref": "#/$defs/hex" }, "accent6": { "$ref": "#/$defs/hex" },
            "hlink": { "$ref": "#/$defs/hex" }, "folHlink": { "$ref": "#/$defs/hex" }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": { "type": "string", "description": "Heading font." },
            "minor": { "type": "string", "description": "Body font." }
          }
        },
        "named_palette": {
          "type": "object",
          "description": "Optional friendly aliases the extractor maps from theme slots or a naming convention (e.g. 'astellas-red' -> accent1).",
          "additionalProperties": { "$ref": "#/$defs/hex" }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_in", "height_in"],
      "properties": {
        "width_in": { "type": "number" },
        "height_in": { "type": "number" },
        "aspect": { "type": "string", "enum": ["16:9", "4:3", "other"] }
      }
    },
    "layouts": {
      "type": "array",
      "description": "One entry per slide layout in the .potx. Purely STRUCTURAL — no intent semantics live here (those are the sidecar's job).",
      "items": { "$ref": "#/$defs/layout" }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_in", "y_in", "w_in", "h_in"],
      "properties": {
        "x_in": { "type": "number" }, "y_in": { "type": "number" },
        "w_in": { "type": "number" }, "h_in": { "type": "number" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_layout_name", "slots"],
      "properties": {
        "id": { "type": "string", "description": "Stable id, derived from the layout name convention (e.g. REVEAL_GRID). Sidecars reference layouts by this id." },
        "source_layout_name": { "type": "string", "description": "The layout name exactly as authored in PowerPoint." },
        "description": { "type": "string" },
        "render_strategy": {
          "type": "string",
          "enum": ["native", "programmatic"],
          "description": "native = fill this .potx layout's placeholders directly (highest fidelity, fixed slots). programmatic = re-draw with extracted tokens (needed for variable-N/complex). Extractor guesses; human can override."
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        },
        "exemplar": {
          "type": "object",
          "description": "For variable-N layouts (card grids): one card's geometry + style so a programmatic generator can clone/position N of them.",
          "additionalProperties": false,
          "properties": {
            "of_slot": { "type": "string", "description": "Which slot name this is an exemplar for." },
            "geometry": { "$ref": "#/$defs/geometry" },
            "gutter_in": { "type": "number" },
            "grid": { "type": "string", "description": "Preferred packing, e.g. '2x2', '3-up', 'single-column'." }
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "geometry"],
      "properties": {
        "name": { "type": "string", "description": "Placeholder/shape name as authored. Also the binding key sidecars map into." },
        "type": {
          "type": "string",
          "enum": ["title", "subtitle", "body", "caption", "picture", "chart", "table", "card", "number_chip", "control", "standards_note", "freeform"]
        },
        "geometry": { "$ref": "#/$defs/geometry" },
        "repeatable": { "type": "boolean", "description": "True for slots that recur (e.g. reveal cards); pairs with layout.exemplar." },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_chars": { "type": "integer" },
            "max_lines": { "type": "integer" },
            "font_size_pt": { "type": "number" }
          }
        },
        "storyline": {
          "type": "object",
          "description": "Storyline binding metadata, if the shape was named/tagged in the .potx. This is what makes import deterministic.",
          "additionalProperties": false,
          "properties": {
            "shape_name": { "type": "string", "description": "e.g. btn_next, card1" },
            "role": { "type": "string", "enum": ["button", "layer_target", "variable_source", "static"] },
            "alt_text_template": { "type": "string", "description": "e.g. SL_CONTROL:{\"type\":\"button\",\"states\":[\"Normal\",\"Hover\",\"Visited\"]}" }
          }
        }
      }
    }
  }
}
