    {
      "id": "s1",
      "title": "What Is ALSAP?",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "What Is ALSAP?"
          },
          "meta": {
            "renderUnitId": "s1_u1",
            "semanticRole": "Head",
            "instructionalIntent": "orient",
            "treatment": "summary-highlight",
            "primitive": "StaticHead",
            "styleRef": "head-primary",
            "sourceElementIds": [
              "s1_head_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "ALSAP is a structured way to think about important workplace conversations so that managers can approach them with greater clarity, consistency, and purpose.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s1_u2",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s1_para_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "This course introduces the framework, explains what each part is meant to help you do, and gives you a simple way to test your understanding before you apply it in practice.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s1_u3",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s1_para_02"
            ]
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 3,
            "text": "This is not just a model to remember. It is a way to handle moments that matter."
          },
          "meta": {
