    {
      "id": "why_pay_ranges",
      "title": "Why you're seeing pay ranges",
      "kind": "scene",
      "role": "front_matter",
      "components": [
        {
          "type": "Body",
          "props": {
            "text": "Welcome \u2014 this is about your pay: what's changing, how it's set, and what it means for you.",
            "kicker": ""
          },
          "meta": {
            "beat_id": "bt_paytrans_welcome",
            "intent": {
              "pedagogical": "hook"
            },
            "placement": "lesson_start"
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "Why you're seeing pay ranges",
            "kicker": "Why this"
          },
          "meta": {
            "scene_id": "why_pay_ranges",
            "role": "front_matter"
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "Brunswick is committed to open, informed conversations about compensation \u2014 they're part of a positive work environment.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_commitment",
            "composed_from": "atom_bw_guide_commitment",
            "text_primitive": "tp_display",
            "style_ref": "brand.opening",
            "structure": {
              "group": "atom_bw_guide_commitment",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "In 2025, several U.S. states implement new pay transparency laws \u2014 laws that require employers to disclose salary ranges and benefits in job postings or during the hiring process. The aim: pay equity, transparency, and fair compensation practices.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_commitment_laws",
            "composed_from": "atom_bw_guide_commitment_laws",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_commitment",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "New pay transparency laws take effect in 2025 \u2014 and we're proud to be including salary ranges and benefits information in all our new job postings.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_commitment_postings",
            "composed_from": "atom_bw_guide_commitment_postings",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_commitment",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Transparency builds trust. That's why we're preparing managers to have open, informed conversations about compensation.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_commitment_trust",
            "composed_from": "atom_bw_guide_commitment_trust",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_commitment",
              "depth": 1,
              "head": false
            }
          }
        }
      ]
    },
    {
      "id": "how_pay_is_determined",
      "title": "How pay is determined",
      "kind": "scene",
      "role": "topic",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "How pay is determined",
            "kicker": "The philosophy"
          },
          "meta": {
            "scene_id": "how_pay_is_determined",
            "role": "topic"
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Brunswick's Compensation Philosophy",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy",
            "composed_from": "atom_bw_guide_philosophy",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Market-Competitive Compensation, Set Through Benchmarking",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_benchmarking",
            "composed_from": "atom_bw_guide_philosophy_benchmarking",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Accurate job descriptions keep roles aligned in compensation surveys, and market data from trusted sources is used to assess job value and total rewards programs. A total rewards mindset shapes a package that attracts and keeps top talent.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_benchmarking_how",
            "composed_from": "atom_bw_guide_philosophy_benchmarking_how",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Balance External Competitiveness with Internal Equity",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_equity",
            "composed_from": "atom_bw_guide_philosophy_equity",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Market data is a guide \u2014 but internal equity matters just as much. Every job is placed in the Brunswick grade structure based on both its external market data and its internal value.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_equity_how",
            "composed_from": "atom_bw_guide_philosophy_equity_how",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Link Pay to Individual, Team & Company Performance",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_p4p",
            "composed_from": "atom_bw_guide_philosophy_p4p",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Exceptional performance gets recognized and rewarded \u2014 through annual merit increases and incentive plans \u2014 based on your individual contributions plus team and company performance.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_philosophy_p4p_how",
            "composed_from": "atom_bw_guide_philosophy_p4p_how",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_philosophy",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "How Your Base Pay Is Set",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_base_pay",
            "composed_from": "atom_bw_guide_base_pay",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Brunswick uses a traditional grade structure \u2014 24 pay ranges, each closely tied to market rates through our compensation surveys and benchmarking exercises.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_base_pay_grades",
            "composed_from": "atom_bw_guide_base_pay_grades",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "The grade structure splits into three geographic zones, each reflecting the cost of labor in different U.S. locations \u2014 accounting for the varied pay rates across our widespread locations.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_base_pay_zones",
            "composed_from": "atom_bw_guide_base_pay_zones",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Every grade has a minimum, midpoint, and maximum, plus a market range for base salary \u2014 and its own target for incentive pay.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_base_pay_range",
            "composed_from": "atom_bw_guide_base_pay_range",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Where people typically fall within the range:",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_base_pay_range_positions",
            "composed_from": "atom_bw_guide_base_pay_range_positions",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "StepList",
          "props": {
            "kicker": "",
            "title": "Where people typically fall within the range:",
            "ordered": false,
            "items": [
              {
                "id": "ele_bw_guide_base_pay_range_positions_low",
                "composed_from": "atom_bw_guide_base_pay_range_positions_low",
                "text": "Lower in the range: new hires with minimal experience, recent promotions into much larger jobs, roles newly placed in a grade by job evaluation, or performance below expectations."
              },
              {
                "id": "ele_bw_guide_base_pay_range_positions_mid",
                "composed_from": "atom_bw_guide_base_pay_range_positions_mid",
                "text": "Around the market median: successful performers who are \u201cfully competent\u201d in their role, and experienced new hires."
              },
              {
                "id": "ele_bw_guide_base_pay_range_positions_high",
                "composed_from": "atom_bw_guide_base_pay_range_positions_high",
                "text": "Higher in the range: long-term employees who have stayed in role, highly skilled or high-demand positions, and the highest sustained performers."
              }
            ]
          },
          "meta": {
            "element_ids": [
              "ele_bw_guide_base_pay_range_positions_low",
              "ele_bw_guide_base_pay_range_positions_mid",
              "ele_bw_guide_base_pay_range_positions_high"
            ],
            "composed_from": [
              "atom_bw_guide_base_pay_range_positions_low",
              "atom_bw_guide_base_pay_range_positions_mid",
              "atom_bw_guide_base_pay_range_positions_high"
            ],
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_base_pay",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Shaping Pay as Part of Enterprise HR: the Compensation and Benefits team, in strong partnership with division HR teams, regularly reviews compensation data, benchmarks against market trends, and assesses internal pay levels \u2014 so pay stays fair and competitive for all employees.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_stewardship",
            "composed_from": "atom_bw_guide_stewardship",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_stewardship",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Key activities at the enterprise level:",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_guide_stewardship_activities",
            "composed_from": "atom_bw_guide_stewardship_activities",
            "text_primitive": "tp_body",
            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_guide_stewardship",
              "depth": 1,
              "head": false
            }
          }
        },
        {
          "type": "StepList",
          "props": {
            "kicker": "",
            "title": "Key activities at the enterprise level:",
            "ordered": false,
            "items": [
              {
                "id": "ele_bw_guide_stewardship_activities_2",
                "composed_from": "atom_bw_guide_stewardship_activities_2",
                "text": "Participate in market surveys to benchmark compensation against industry standards \u2014 and keep it competitive."
              },
              {
                "id": "ele_bw_guide_stewardship_activities_3",
                "composed_from": "atom_bw_guide_stewardship_activities_3",
                "text": "Perform on-demand and planned role analyses to assess job responsibilities, market value, and internal equity."
              }
            ]
          },
          "meta": {
            "element_ids": [
              "ele_bw_guide_stewardship_activities_2",
              "ele_bw_guide_stewardship_activities_3"
            ],
            "composed_from": [
