            "style_ref": "brand.instructional",
            "structure": {
              "group": "atom_bw_framework_total_rewards",
              "depth": 0,
              "head": true
            }
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "A portion of your pay is variable compensation \u2014 with targets, like base salary, set from competitive market data. As you move up through the organization, the mix shifts: less base, more variable.",
            "kicker": ""
          },
          "meta": {
            "element_id": "ele_bw_framework_total_rewards_variable",
            "composed_from": "atom_bw_framework_total_rewards_variable",
