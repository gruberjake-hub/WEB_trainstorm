    "meaning": {
      "source_locale": "en",
      "source_text": "define an implementation schedule for new or revised artwork",
      "kind": "list_item"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_sop_2290_purpose_items",
        "order": 2
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
      "regulatory_binding": "regulatory",
      "owner": "team_pt_scm_emea"
