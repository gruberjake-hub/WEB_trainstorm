  {
    "atom_id": "atom_sop_ast29080_purpose",
    "content_hash": "sha256:0f12058f6f9dad4d1a7c7bcbb33ab9d0e60bd2683081e69b75cd20aa19bb81f1",
    "meaning": {
      "source_locale": "en",
      "source_text": "The purpose of this SOP is to define the process for planning, developing, executing, maintaining, and archiving the Asset Level Safety Assessment Plan (ALSAP) for use in asset-level safety monitoring during clinical development.",
      "kind": "procedure"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_sop_ast29080",
        "order": 0
      }
    },
    "governance": {
