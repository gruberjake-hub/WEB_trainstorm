+#!/usr/bin/env python3
+"""
+The voice-pack gate — Dragoman's gate for the REGISTER coordinate.
+
+Voice packs are the first store that re-expresses MEANING itself (learner-facing copy as a
+rendering, external and keyed, never embedded). This gate enforces the contract layer:
+
+    SCHEMA        — the pack validates against schemas/voice.pack.schema.json.
+    GOVERNANCE    — the pack's register resolves to vocab/register.enum.json (closed list), and
+                    ACCEPTED entries are only admitted for a `specified` register; renderings
+                    authored against a `draft` register are flagged, not silently admitted.
+    ANCHOR        — every entry keys a real atom in the project store, and its source_hash matches
+                    the atom's CURRENT content_hash. A mismatch = the meaning moved = stale.
+    CHAIN         — where derived_from is present (element overrides chaining from the pack's own
+                    atom-level entry), the pinned hash matches sha256 of the source entry's text.
+
+What it does NOT check: meaning preservation itself. That is voice mode's review gate (the
+invent-guard), a later hop — this gate is the bookkeeping that makes that one possible.
+
+    python3 tools/validate_voice.py --project ../brunswick/projects/paytrans   # gate real packs
+    python3 tools/validate_voice.py --selftest                                  # fixtures, proves red
+
+With --project and no voice/ dir present, the run is a contract-only pass (schema + vocab) and says
+so — packs are optional until the writer hop lands.
+"""
+import argparse, hashlib, json, sys
+from jsonschema import Draft202012Validator
+import harness_paths
+
+ap = argparse.ArgumentParser(add_help=False)
+ap.add_argument("--core"); ap.add_argument("--project"); ap.add_argument("--selftest", action="store_true")
+args, _ = ap.parse_known_args()
+
+P = harness_paths.resolve_core(args.core)
+schema_p = P["schemas_dir"] / "voice.pack.schema.json"
+vocab_p = P["vocab_dir"] / "register.enum.json"
+for _p in (schema_p, vocab_p):
+    if not _p.exists():
+        raise SystemExit(f"not found: {_p}")
+schema = json.loads(schema_p.read_text())
+vocab = json.loads(vocab_p.read_text())
+
+results = []
+
+def sha(text: str) -> str:
+    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+# ---------------------------------------------------------------- contract layer (always runs)
+
+try:
+    Draft202012Validator.check_schema(schema)
+    results.append(("voice.pack.schema is valid Draft 2020-12", True, ""))
+except Exception as e:
+    results.append(("voice.pack.schema is valid Draft 2020-12", False, str(e)))
+
+V = Draft202012Validator(schema)
+
+_ids = [v["id"] for v in vocab.get("values", [])]
+results.append(("register vocab: ids unique", len(_ids) == len(set(_ids)), ", ".join(_ids)))
+results.append(("register vocab: closed list declared", vocab.get("governance", {}).get("closed_list") is True, ""))
+_bad_status = [v["id"] for v in vocab.get("values", []) if v.get("status") not in ("specified", "draft")]
+results.append(("register vocab: every status is specified|draft", not _bad_status, ", ".join(_bad_status)))
+_specified = {v["id"] for v in vocab.get("values", []) if v.get("status") == "specified"}
+_governed = set(_ids)
+
+# ---------------------------------------------------------------- pack gate (shared by both modes)
+
+def gate_pack(name, pack, atoms_by_id):
+    """Append results for one pack dict against the atom store {atom_id: content_hash}."""
+    errs = sorted(V.iter_errors(pack), key=lambda e: list(e.path))
+    results.append((f"{name}: validates against schema", not errs,
+                    "; ".join(e.message for e in errs)[:180]))
+    if errs:
+        return
+    reg = pack["register"]
+    results.append((f"{name}: register '{reg}' is governed", reg in _governed, ""))
+    accepted = [k for k, e in pack.get("entries", {}).items() if e.get("status") == "accepted"] + \
+               [k for k, e in pack.get("element_overrides", {}).items() if e.get("status") == "accepted"]
+    if reg in _governed and reg not in _specified:
+        results.append((f"{name}: no accepted entries against draft register", not accepted,
+                        f"accepted against draft '{reg}': " + ", ".join(accepted)))
+    for aid, entry in pack.get("entries", {}).items():
+        if aid not in atoms_by_id:
+            results.append((f"{name}: entry {aid} keys a real atom", False, "no such atom in store"))
+            continue
+        fresh = entry["source_hash"] == atoms_by_id[aid]
+        results.append((f"{name}: entry {aid} source_hash is fresh", fresh,
+                        "" if fresh else "atom content_hash moved — rendering is STALE"))
+    for eid, entry in pack.get("element_overrides", {}).items():
+        df = entry.get("derived_from")
+        if not df:
+            continue
+        src = pack.get("entries", {}).get(df["key"])
+        if src is None:
+            results.append((f"{name}: override {eid} derives from a present entry", False,
+                            f"derived_from.key {df['key']} not in this pack"))
+            continue
+        fresh = df["hash"] == sha(src["text"])
+        results.append((f"{name}: override {eid} chain hash is fresh", fresh,
+                        "" if fresh else "source entry's text moved — override is STALE"))
+
+# ---------------------------------------------------------------- selftest (fixtures; proves red)
+
+if args.selftest:
+    ATOMS = {"atom_fx_alpha": sha("Employees receive the pay range for their role."),
+             "atom_fx_beta": sha("Ranges are reviewed annually.")}
+    good = {
+        "pack_version": "voice.v0.1",
+        "register": "warm_direct",
+        "entries": {
+            "atom_fx_alpha": {"text": "You'll see the pay range for your role — it's yours to know.",
+                               "status": "accepted", "reviewer": "jake",
+                               "source_hash": ATOMS["atom_fx_alpha"]},
+            "atom_fx_beta": {"text": "Ranges get a fresh look every year.",
+                              "status": "draft",
+                              "source_hash": ATOMS["atom_fx_beta"]}
+        },
+        "element_overrides": {
+            "ele_fx_head": {"text": "Your Pay Range", "status": "draft",
+                             "source_hash": ATOMS["atom_fx_alpha"],
+                             "derived_from": {"pack": "voice/warm_direct.json", "key": "atom_fx_alpha",
+                                               "hash": sha("You'll see the pay range for your role — it's yours to know.")}}
+        }
+    }
+    n0 = len(results); gate_pack("fixture(good)", good, ATOMS)
+    results.append(("selftest: clean fixture passes every pack check",
+                    all(ok for _, ok, _ in results[n0:]), ""))
+
+    def red(label, mutate):
+        pack = json.loads(json.dumps(good))
+        atoms = dict(ATOMS)
+        mutate(pack, atoms)
+        hold = results[:]           # run the gate into a scratch window, then restore
+        del results[:]
+        gate_pack("fixture(red)", pack, atoms)
+        failed = any(not ok for _, ok, _ in results)
+        del results[:]
+        results.extend(hold)
+        results.append((label, failed, "" if failed else "mutation was NOT caught"))
+
+    red("selftest: ungoverned register is caught",
+        lambda p, a: p.update(register="chatty_casual"))
+    red("selftest: accepted entry against a draft register is caught",
+        lambda p, a: p.update(register="executive_brief"))
+    red("selftest: accepted entry without reviewer is caught",
+        lambda p, a: p["entries"]["atom_fx_alpha"].pop("reviewer"))
+    red("selftest: malformed source_hash is caught",
+        lambda p, a: p["entries"]["atom_fx_beta"].update(source_hash="sha256:short"))
+    red("selftest: stale source_hash (meaning moved) is caught",
+        lambda p, a: a.update(atom_fx_alpha=sha("Employees receive the pay range for their role, updated.")))
+    red("selftest: entry keying a missing atom is caught",
+        lambda p, a: a.pop("atom_fx_beta"))
+    red("selftest: stale derived_from chain hash is caught",
+        lambda p, a: p["entries"]["atom_fx_alpha"].update(text="You'll see the pay range for your role."))
+    red("selftest: embedded-shape entry (extra field) is caught",
+        lambda p, a: p["entries"]["atom_fx_alpha"].update(translation_ja="給与範囲"))
+
+# ---------------------------------------------------------------- project mode (real packs)
+
+else:
+    PP = harness_paths.resolve()
+    proj = PP["project_dir"]
+    atoms_p = proj / "atoms.json"
+    if not atoms_p.exists():
+        raise SystemExit(f"not found: {atoms_p}")
+    _atoms = json.loads(atoms_p.read_text())
+    _alist = _atoms["atoms"] if isinstance(_atoms, dict) and "atoms" in _atoms else _atoms
+    atoms_by_id = {a["atom_id"]: a["content_hash"] for a in _alist}
+    voice_dir = proj / "voice"
+    packs = sorted(voice_dir.glob("*.json")) if voice_dir.exists() else []
+    if not packs:
+        results.append(("no voice packs in project — contract-only pass", True,
+                        f"looked in {voice_dir}"))
+    for pk in packs:
+        gate_pack(pk.name, json.loads(pk.read_text()), atoms_by_id)
+
+# ---------------------------------------------------------------- report
+
+print(f"{'CHECK':<62} RESULT")
+print("-" * 76)
+ok = True
+for name, passed, detail in results:
+    ok = ok and passed
+    print(f"{name:<62} {'PASS' if passed else 'FAIL'}   {detail if not passed else ''}")
+print("-" * 76)
+print("ALL PASS" if ok else "SOME FAILED")
+sys.exit(0 if ok else 1)
-- 
