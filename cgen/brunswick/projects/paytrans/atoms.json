      "owner": "team_bw_enterprise_hr_comp_benefits"
    }
  },
  {
    "atom_id": "atom_bw_framework",
    "content_hash": "sha256:7c2cb8708485706f59adf7c279f20f304ea89630f4b56157a2c8ec8b3a73a3b5",
    "meaning": {
      "source_locale": "en",
      "source_text": "Compensation Philosophy & Framework 2025 (v3) — enterprise overview of total rewards, base pay, incentive compensation, pay for performance, and pay transparency.",
      "kind": "document"
    },
    "bindings": {},
    "governance": {
      "version": 1,
      "status": "draft",
