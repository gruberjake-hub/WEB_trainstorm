  {
    "atom_id": "atom_bw_guide_philosophy_benchmarking",
    "content_hash": "sha256:03467f65f66e982b07511af0d9a9feb8e4e0fb6bbd6964c34987d0cea0cca43a",
    "meaning": {
      "source_locale": "en",
      "source_text": "Set Market-Competitive Compensation Through Benchmarking.",
      "kind": "statement"
    },
    "bindings": {
