    "content_hash": "sha256:3ef4cecb01c189a5d27247e7292a2a3ba51da402313f89581ed26625860f3915",
    "meaning": {
      "source_locale": "en",
      "source_text": "This SOP applies to all Astellas and non-Astellas employees responsible for supporting ALSAP throughout its lifecycle. The in-scope organizations are listed below.",
      "kind": "procedure"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_sop_ast29080",
        "order": 1
      }
    },
    "governance": {
