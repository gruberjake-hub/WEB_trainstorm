{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trainstorm.ai/schema/scene.schema.json",
  "title": "Trainstorm Scene Schema",
  "type": "object",
  "required": ["scene_id", "elements"],
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^sce_[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "elements": {
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^(Head|SubHead|ContentHead|ListHead|List|Bullet|Statement|Paragraph|Impact|Quote|Callout)_[0-9]{2}$"
  },
  "additionalProperties": {
    "$ref": "#/definitions/sceneElement"
  }
},
    "narration": {
      "$ref": "#/definitions/narration"
    },
    "assets": {
      "$ref": "#/definitions/assets"
    },
    "render": {
      "$ref": "#/definitions/render"
    }
  },
  "definitions": {
    "sceneElement": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Head",
            "SubHead",
            "ContentHead",
            "ListHead",
            "List",
            "Bullet",
            "Statement",
            "Paragraph",
            "Impact",
            "Quote"
          ]
        },
        "intent": {
          "enum": [
            "orient",
            "refine",
            "organize",
            "structure",
            "specify",
            "assert",
            "explain",
            "persuade",
            "contextualize",
            "transition",
            "support"
          ]
        },
        "text": {
          "type": "string"
        },
        "voice_text": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "text_primitive": {
          "type": "string"
        },
        "motion_primitive": {
          "type": "string"
        },
        "layout_primitive": {
          "type": "string"
        },
        "interaction_primitive": {
          "type": "string"
        },
        "style_ref": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_id": {
          "type": "string"
        },
        "voice_name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "audio_file": {
          "type": "string"
        },
        "duration_estimate_sec": {
          "type": "number"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ae_comp": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "output_file": {
          "type": "string"
        },
        "review_required": {
          "type": "boolean"
        }
      }
    }
  }
}