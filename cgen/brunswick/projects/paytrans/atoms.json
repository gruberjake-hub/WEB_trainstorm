    "content_hash": "sha256:b7b34f92ab7553ba54df327c52935457d3ccd1da2a237702f9c08d8adedfaa6b",
    "meaning": {
      "source_locale": "en",
      "source_text": "Brunswick is committed to fostering a positive work environment through open, informed compensation discussions.",
      "kind": "section"
    },
    "bindings": {
