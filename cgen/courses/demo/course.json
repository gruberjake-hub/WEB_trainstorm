          "props": {
            "id": "s4_list_01",
            "items": [
              {
                "id": "s4_item_01",
                "title": "Assess",
                "body": "Helps you slow down and understand the situation before reacting."
              },
              {
                "id": "s4_item_02",
                "title": "Listen",
                "body": "Helps you understand the other person’s perspective more fully."
              },
              {
                "id": "s4_item_03",
                "title": "Specify",
                "body": "Helps you clarify what matters so the conversation stays focused."
              },
              {
                "id": "s4_item_04",
                "title": "Align",
                "body": "Helps you build shared understanding around expectations and outcomes."
              },
              {
                "id": "s4_item_05",
                "title": "Proceed",
                "body": "Helps you move toward a clear next step instead of leaving things unresolved."
              }
            ],
            "requireAllRevealedToComplete": true
          },
          "meta": {
            "renderUnitId": "s4_u3",
            "semanticRole": "List",
