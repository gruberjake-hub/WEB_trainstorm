    {
      "id": "s2",
      "title": "Why These Moments Matter",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "Why These Moments Matter"
          },
          "meta": {
            "renderUnitId": "s2_u1",
            "semanticRole": "Head",
            "instructionalIntent": "orient",
            "treatment": "summary-highlight",
            "primitive": "StaticHead",
            "styleRef": "head-primary",
            "sourceElementIds": [
              "s2_head_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "Managers are often asked to handle conversations that carry real emotional, professional, and organizational weight. In those moments, a vague or reactive approach can create confusion, defensiveness, or missed opportunities.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s2_u2",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s2_para_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "The point is not to sound scripted. The point is to think more clearly under pressure.",
            "emphasis": "medium",
            "role": "Statement"
          },
          "meta": {
            "renderUnitId": "s2_u3",
            "semanticRole": "Statement",
            "instructionalIntent": "assert",
            "treatment": "emphasized-assertion",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s2_statement_01"
            ]
          }
        },
        {
          "type": "Body",
          "props": {
            "text": "ALSAP gives you a repeatable structure for approaching these moments with more intention, so that the conversation serves both the person and the purpose.",
            "emphasis": "none",
            "role": "Paragraph"
          },
          "meta": {
            "renderUnitId": "s2_u4",
            "semanticRole": "Paragraph",
            "instructionalIntent": "explain",
            "treatment": "plain-exposition",
            "primitive": "BodyFade",
            "styleRef": "content-body",
            "sourceElementIds": [
              "s2_para_02"
            ]
          }
        },
        {
          "type": "Heading",
          "props": {
            "level": 3,
            "text": "Handled well, these conversations build trust. Handled poorly, they can quietly erode it."
          },
          "meta": {
            "renderUnitId": "s2_u5",
            "semanticRole": "Impact",
            "instructionalIntent": "persuade",
            "treatment": "emphasized-assertion",
            "primitive": "FocusReveal",
            "styleRef": "impact-emphasis",
            "sourceElementIds": [
              "s2_impact_01"
            ]
          }
        }
      ],
