    {
      "id": "s5",
      "title": "What Good Use Looks Like",
      "components": [
        {
          "type": "Heading",
          "props": {
            "level": 2,
            "text": "What Good Use Looks Like"
          },
          "meta": {
            "renderUnitId": "s5_u1",
            "semanticRole": "Head",
            "instructionalIntent": "orient",
            "treatment": "summary-highlight",
            "primitive": "StaticHead",
