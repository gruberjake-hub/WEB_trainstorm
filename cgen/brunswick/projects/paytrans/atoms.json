    "content_hash": "sha256:da72d2f48ccbd63fa5c94bcf5d16a71afaa373d6f05996a2f3c2f8ce115b242f",
    "meaning": {
      "source_locale": "en",
      "source_text": "Annual incentives are the primary compensation element used to measure performance against established business goals and reward accomplishments within a given year. There is a clear link between individual performance and final incentive payout.",
      "kind": "statement"
