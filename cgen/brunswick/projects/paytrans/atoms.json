  },
  {
    "atom_id": "atom_bw_framework_total_rewards",
    "content_hash": "sha256:91998b7efbc43c2c1ee93205d15aa6b670f79eb1d9e167eb05b42dd39fa88ab3",
    "meaning": {
      "source_locale": "en",
      "source_text": "Total rewards: your total compensation is so much more than just a paycheck and includes other benefits, bonuses and company provided offerings from Brunswick.",
      "kind": "section"
    },
    "bindings": {
      "object": {
        "belongs_to": "atom_bw_framework",
        "order": 0
      }
    },
    "governance": {
      "version": 1,
      "status": "draft",
